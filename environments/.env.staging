# environments/.env.staging
# ─────────────────────────────────────────────────────────────
# Staging Environment — mirrors production config
# Use staging DB, staging Redis, staging domain
# ─────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=5000
APP_VERSION=staging

DATABASE_URL=postgresql://staging_user:CHANGE_ME@staging-db.yourdomain.com:5432/stagingdb
DB_USER=staging_user
DB_PASSWORD=CHANGE_ME
DB_NAME=stagingdb

REDIS_URL=redis://:CHANGE_ME@staging-redis.yourdomain.com:6379
REDIS_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_STAGING_JWT
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_REFRESH

ALLOWED_ORIGINS=https://staging.yourdomain.com

DOMAIN=staging.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME_STAGING
