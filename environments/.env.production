# environments/.env.production
# ─────────────────────────────────────────────────────────────
# Production Environment Variables
# ⚠️  NEVER commit real values to git!
# Store secrets in GitHub Secrets → deploy via CI/CD
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000

# App version (set by CI/CD pipeline)
APP_VERSION=1.0.0

# Database — use a managed Postgres (RDS, Supabase, Neon, etc.)
DATABASE_URL=postgresql://prod_user:CHANGE_ME@db.yourdomain.com:5432/proddb
DB_USER=prod_user
DB_PASSWORD=CHANGE_ME
DB_NAME=proddb

# Redis — use managed Redis (Upstash, Elasticache, etc.)
REDIS_URL=redis://:CHANGE_ME@redis.yourdomain.com:6379
REDIS_PASSWORD=CHANGE_ME

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/TLS
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# Monitoring
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
ALERT_EMAIL=ops@yourdomain.com

# Container registry
REGISTRY=ghcr.io/yourusername/clouddeploy-app
